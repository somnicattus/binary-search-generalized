{
	"extends": "@tsconfig/strictest",
	"compilerOptions": {
		/* Language and Environment */
		"target": "ES2020",
		"lib": ["ES2020"],

		/* Modules */
		"module": "node20",
		"moduleResolution": "node16",

		/* Emit */
		"noEmit": true,
		"declaration": true,

		/* JavaScript Support */
		"allowJs": false,
		"checkJs": false,

		/* Interop Constraints */
		"isolatedDeclarations": true
	},
	"include": ["**/*.ts", "**/*.js"],
	"exclude": ["node_modules", "dist"]
}
